# Copie para deploy/deploy.env (fica fora do git) e preencha com os dados do seu servidor.
# Use autenticação por chave SSH; o script nunca pede nem guarda senha.

# Endereço do servidor (IP ou nome) e usuário com sudo ou root
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
# Chave privada SSH (vazio = usa a padrão do ~/.ssh ou o ssh-agent)
DEPLOY_SSH_KEY=
# Pasta do projeto no servidor
DEPLOY_PATH=/opt/fabrics

# Domínio público do site, já apontando (registro DNS A/AAAA) para o servidor.
# Vazio = serve só por HTTP na porta 80, pelo IP.
DOMAIN=
