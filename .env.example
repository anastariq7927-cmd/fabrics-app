# Copie para .env e preencha. Todos os serviços leem este arquivo da raiz.

# --- Supabase ---
SUPABASE_URL=https://ircemdwccpjfrpyikwds.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Secret/service role key (Dashboard → Project Settings → API Keys). Usada só pelo serviço de contato.
SUPABASE_SERVICE_ROLE_KEY=
# Só no servidor com Supabase self-hosted (preenchido por scripts/deploy.sh supabase): endereço público
# usado nos links de download entregues ao navegador. Vazio = igual a SUPABASE_URL.
SUPABASE_PUBLIC_URL=

# --- Microserviços ---
GATEWAY_PORT=4000
CONTENT_PORT=4001
CONTACT_PORT=4002
EMAIL_PORT=4003
FABRICATION_PORT=4004
CONTENT_SERVICE_URL=http://localhost:4001
CONTACT_SERVICE_URL=http://localhost:4002
EMAIL_SERVICE_URL=http://localhost:4003
FABRICATION_SERVICE_URL=http://localhost:4004
# URL pública do site, usada nos links de acompanhamento dos emails
PUBLIC_SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Token compartilhado entre serviços internos (gere um valor aleatório longo)
INTERNAL_TOKEN=

# --- Email (serviço email + MCP email-smtp-imap) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
# IMAP_USER / IMAP_PASS usam as credenciais SMTP se omitidos
MAIL_FROM=
# Caixa que recebe as mensagens do formulário (padrão: SMTP_USER)
MAIL_TO=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://ircemdwccpjfrpyikwds.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
